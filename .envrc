# shellcheck shell=bash
# Loaded by direnv. Run `direnv allow` once.
use flake

# ── App ───────────────────────────────────────────────────────────
export NODE_ENV=development
export LOG_LEVEL=debug
export TZ=Europe/Berlin

# ── API ───────────────────────────────────────────────────────────
export API_PORT=8787
export API_PUBLIC_URL="http://localhost:${API_PORT}"
export WEB_PUBLIC_URL="http://localhost:5173"
export CORS_ORIGINS="${WEB_PUBLIC_URL}"

# ── Database (local Postgres from the flake, see `just db-up`) ─────
export POSTGRES_DB=samsung
export POSTGRES_USER=samsung
export DATABASE_URL="postgres://${POSTGRES_USER}@localhost:${PGPORT:-5432}/${POSTGRES_DB}"

# ── Auth (app login) ──────────────────────────────────────────────
# SESSION_SECRET is set in .env.local (never committed).
export SESSION_COOKIE_NAME=samsung_session
export SESSION_TTL_DAYS=30

# ── SmartThings ───────────────────────────────────────────────────
# Needs the paid SmartThings Developer Plan (from 2026-12-15).
# Create an API Access App in the SmartThings Developer Workspace and
# put SMARTTHINGS_CLIENT_ID / SMARTTHINGS_CLIENT_SECRET in .env.local.
export SMARTTHINGS_API_URL="https://api.smartthings.com/v1"
export SMARTTHINGS_AUTH_URL="https://api.smartthings.com/oauth/authorize"
export SMARTTHINGS_TOKEN_URL="https://auth-global.api.smartthings.com/oauth/token"
export SMARTTHINGS_REDIRECT_URI="${API_PUBLIC_URL}/auth/smartthings/callback"
export SMARTTHINGS_SCOPES="r:devices:* x:devices:* r:locations:*"
export SMARTTHINGS_WEBHOOK_URL="${API_PUBLIC_URL}/webhooks/smartthings"
# Monthly call budget of the Developer Plan; the poller paces itself to stay below it.
export SMARTTHINGS_MONTHLY_CALL_BUDGET=100000
export SMARTTHINGS_POLL_INTERVAL_SECONDS=300

# ── Web (Vite exposes only VITE_*) ────────────────────────────────
export VITE_API_URL="${API_PUBLIC_URL}"

# ── Secrets (gitignored) ──────────────────────────────────────────
dotenv_if_exists .env.local
